// =============== MAIN FUNCTION ===============

int main() {

    srand((unsigned int)time(0));

    SetConsoleTitle("Arcade Gaming System - Snake and Tetris");

    string player;

    clearScreen();

    title("WELCOME TO ARCADE GAMING SYSTEM");

    cout << "Enter Player Name (no spaces): ";
    cin >> player;

    int choice;

    do {

        drawMenu();

        if (!(cin >> choice)) {
            cin.clear();
            cin.ignore(1000, '\n');
            choice = 0;
        }

        switch (choice) {

            case 1: {

                Snake game(player);
                game.play();
                break;
            }

            case 2: {

                Tetris game(player);
                game.play();
                break;
            }

            case 3: {

                ScoreManager manager;
                manager.displayScores();
                break;
            }

            case 4:

                instructions();
                break;

            case 5:

                clearScreen();

                color(10);
                title("THANK YOU FOR PLAYING!");

                color(7);
                break;

            default:

                color(12);
                cout << "\nInvalid choice! Try again.\n";

                Sleep(1000);
        }

    } while (choice != 5);

    return 0;
}
