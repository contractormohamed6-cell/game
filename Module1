int main() {
    srand((unsigned int)time(0));

    int choice;

    do {
        clearScreen();

        cout << "================================\n";
        cout << "       GAMING SYSTEM\n";
        cout << "================================\n";
        cout << "1. Play Snake\n";
        cout << "2. Play Tetris\n";
        cout << "3. Exit\n";
        cout << "================================\n";
        cout << "Enter your choice: ";

        cin >> choice;

        switch (choice) {
            case 1: {
                Snake game;
                game.play();
                break;
            }

            case 2: {
                Tetris game;
                game.play();
                break;
            }

            case 3:
                cout << "Thank you for playing!\n";
                break;

            default:
                cout << "Invalid choice!\n";
                Sleep(1000);
        }

    } while (choice != 3);

    return 0;
}
